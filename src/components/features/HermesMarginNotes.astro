---
import type { HermesMarginNote } from "@/utils/article-visuals";

interface Props {
	notes: HermesMarginNote[];
	articleId: string;
}

const { notes, articleId } = Astro.props;
const serializedNotes = JSON.stringify(notes).replace(/</gu, "\\u003c");
---

{
	notes.length > 0 && (
		<div
			class="hermes-notes-runtime"
			data-hermes-notes-root
			data-article-id={articleId}
			hidden
		>
			<script
				is:inline
				type="application/json"
				data-hermes-notes-data
				set:html={serializedNotes}
			/>
		</div>
	)
}

<script>
	type RuntimeNote = {
		anchor: string;
		text: string;
		explicit: boolean;
	};

	function normalizeAnchor(value: string): string {
		return value.replace(/\s+/gu, "").toLowerCase();
	}

	function initializeHermesMarginNotes() {
		const roots = document.querySelectorAll<HTMLElement>(
			"[data-hermes-notes-root]:not([data-hermes-notes-ready])",
		);

		for (const root of roots) {
			root.dataset.hermesNotesReady = "true";
			const data = root.querySelector<HTMLScriptElement>(
				"[data-hermes-notes-data]",
			);
			const article = root
				.closest("[data-article-with-hermes-notes]")
				?.querySelector<HTMLElement>(".markdown-content");
			if (!data || !article) continue;

			let notes: RuntimeNote[] = [];
			try {
				notes = JSON.parse(data.textContent || "[]") as RuntimeNote[];
			} catch {
				continue;
			}

			const paragraphs = Array.from(article.querySelectorAll("p"));
			for (const [noteIndex, note] of notes.entries()) {
				const paragraph = paragraphs.find((candidate) =>
					normalizeAnchor(candidate.textContent || "").includes(note.anchor),
				);
				if (!paragraph || paragraph.querySelector(".hermes-margin-note")) continue;

				paragraph.classList.add("has-hermes-margin-note");
				const annotation = document.createElement("span");
				annotation.className = "hermes-margin-note";
				annotation.setAttribute("role", "note");
				annotation.setAttribute("data-pagefind-ignore", "all");
				annotation.innerHTML =
					'<span class="hermes-margin-note__label">HERMES // 0' +
					(noteIndex + 1) +
					'</span><span class="hermes-margin-note__text"></span>';
				const text = annotation.querySelector<HTMLElement>(
					".hermes-margin-note__text",
				);
				if (text) text.textContent = note.text;
				paragraph.append(annotation);
			}
		}
	}

	initializeHermesMarginNotes();
	document.addEventListener("astro:page-load", initializeHermesMarginNotes);
	document.addEventListener(
		"swup:contentReplaced",
		initializeHermesMarginNotes,
	);
</script>

<style is:global>
	.markdown-content p.has-hermes-margin-note {
		position: relative;
	}

	.hermes-margin-note {
		display: block;
		margin: 0.8rem 0 0.2rem;
		padding: 0.65rem 0.75rem;
		border-left: 2px solid var(--primary);
		border-radius: 0 0.55rem 0.55rem 0;
		background: color-mix(in srgb, var(--primary) 8%, transparent);
		color: color-mix(in srgb, var(--primary) 42%, currentColor);
		font-size: 0.78rem;
		font-style: normal;
		line-height: 1.55;
	}

	.hermes-margin-note__label,
	.hermes-margin-note__text {
		display: block;
	}

	.hermes-margin-note__label {
		margin-bottom: 0.25rem;
		color: var(--primary);
		font-family: "JetBrains Mono Variable", monospace;
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		opacity: 0.78;
	}

	@media (min-width: 1536px) {
		.hermes-margin-note {
			position: absolute;
			top: 0;
			left: calc(100% + 1.35rem);
			width: 10.5rem;
			margin: 0;
			padding: 0.1rem 0 0.1rem 0.75rem;
			background: transparent;
			opacity: 0.74;
			transition:
				opacity 0.2s ease,
				transform 0.2s ease;
		}

		.has-hermes-margin-note:hover > .hermes-margin-note {
			opacity: 1;
			transform: translateX(0.2rem);
		}
	}
</style>
